{
    "keyboard_name": "PolyKybd Corne42",
    "manufacturer": "PolyFabriq",
    "url": "https://ko-fi.com/polykb",
    "maintainer": "[thpoll]",
    "bootloader": "rp2040",
    "processor": "RP2040",
    "usb": {
        "vid": "0x2021",
        "pid": "0x2008",
        "device_version": "1.0.0"
    },
    "features": {
        "bootmagic": false,
        "command": false,
        "console": true,
        "encoder": true,
        "extrakey": true,
        "mousekey": true,
        "debug": true,
        "unicode": false,
        "unicodemap": true,
        "deferred_exec": true,
        "nkro": true
    },
    "encoder": {
        "rotary": [
            {
                "pin_a": "GP25",
                "pin_b": "GP29"
            }
        ]
    },
    "layout_aliases": {
        "LAYOUT": "LAYOUT_crkbd"
    },
    "layouts": {
        "LAYOUT_crkbd": {
            "layout": [
                {"label":"Tab",   "matrix":[0,0], "x":0,    "y":0.25},
                {"label":"Q",     "matrix":[0,1], "x":1,    "y":0.25},
                {"label":"W",     "matrix":[0,2], "x":2,    "y":0},
                {"label":"E",     "matrix":[0,3], "x":3,    "y":0},
                {"label":"R",     "matrix":[0,4], "x":4,    "y":0},
                {"label":"T",     "matrix":[0,5], "x":5,    "y":0},

                {"label":"FN",    "matrix":[1,0], "x":0,    "y":1.25},
                {"label":"A",     "matrix":[1,1], "x":1,    "y":1.25},
                {"label":"S",     "matrix":[1,2], "x":2,    "y":1},
                {"label":"D",     "matrix":[1,3], "x":3,    "y":1},
                {"label":"F",     "matrix":[1,4], "x":4,    "y":1},
                {"label":"G",     "matrix":[1,5], "x":5,    "y":1},

                {"label":"Shift", "matrix":[2,0], "x":0,    "y":2.25},
                {"label":"Z",     "matrix":[2,1], "x":1,    "y":2.25},
                {"label":"X",     "matrix":[2,2], "x":2,    "y":2},
                {"label":"C",     "matrix":[2,3], "x":3,    "y":2},
                {"label":"V",     "matrix":[2,4], "x":4,    "y":2},
                {"label":"B",     "matrix":[2,5], "x":5,    "y":2},

                {"label":"Alt",   "matrix":[3,3], "x":3.5,  "y":3.25},
                {"label":"Num",   "matrix":[3,4], "x":4.5,  "y":3.5},
                {"label":"Space", "matrix":[3,5], "x":5.5,  "y":3.75},

                {"label":"Y",     "matrix":[4,0], "x":8,    "y":0},
                {"label":"U",     "matrix":[4,1], "x":9,    "y":0},
                {"label":"I",     "matrix":[4,2], "x":10,   "y":0},
                {"label":"O",     "matrix":[4,3], "x":11,   "y":0},
                {"label":"P",     "matrix":[4,4], "x":12,   "y":0.25},
                {"label":"BkSp",  "matrix":[4,5], "x":13,   "y":0.25},

                {"label":"H",     "matrix":[5,0], "x":8,    "y":1},
                {"label":"J",     "matrix":[5,1], "x":9,    "y":1},
                {"label":"K",     "matrix":[5,2], "x":10,   "y":1},
                {"label":"L",     "matrix":[5,3], "x":11,   "y":1},
                {"label":";",     "matrix":[5,4], "x":12,   "y":1.25},
                {"label":"Enter", "matrix":[5,5], "x":13,   "y":1.25},

                {"label":"N",     "matrix":[6,0], "x":8,    "y":2},
                {"label":"M",     "matrix":[6,1], "x":9,    "y":2},
                {"label":",",     "matrix":[6,2], "x":10,   "y":2},
                {"label":".",     "matrix":[6,3], "x":11,   "y":2},
                {"label":"/",     "matrix":[6,4], "x":12,   "y":2.25},
                {"label":"Shift", "matrix":[6,5], "x":13,   "y":2.25},

                {"label":"Enter", "matrix":[7,0], "x":7.5,  "y":3.75},
                {"label":"Lang",  "matrix":[7,1], "x":8.5,  "y":3.5},
                {"label":"Del",   "matrix":[7,2], "x":9.5,  "y":3.25}
            ]
        }
    }
}
